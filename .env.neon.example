# Copy to ignored .env.neon. Never copy production/default endpoints blindly.
# Copy BOTH endpoints from the SAME confirmed development branch in Neon Console.
# Use the operator-provided shared development JWT/identity key ring and shared
# local MinIO configuration. Never distribute the operator's direct/admin connection.
ConnectionStrings__Database=Host=replace-with-verified-development-pooled-host;Port=5432;Database=neondb;Username=replace-with-individual-runtime-role;Password=replace-with-rotated-password;SSL Mode=VerifyFull;Channel Binding=Require;Maximum Pool Size=5;Minimum Pool Size=0;Timeout=30;Command Timeout=30;Include Error Detail=false;Log Parameters=false;Application Name=BHome.SharedDevelopment
# Administration only; API does not consume DatabaseDirect. Copy direct host from Console.
ConnectionStrings__DatabaseDirect=Host=replace-with-verified-development-direct-host;Port=5432;Database=neondb;Username=replace-with-migration-admin-role;Password=replace-with-rotated-admin-password;SSL Mode=VerifyFull;Channel Binding=Require;Pooling=false;Timeout=30;Command Timeout=60
DevelopmentDatabase__InitializeOnStartup=false
DevelopmentDatabase__AllowPreviousPropertySchema=false
Jobs__Enabled=false
NotificationChannels__AutomationEnabled=false
Api__ReadDevelopmentEnvironmentFile=true
# Shared development values from an approved secret channel, not independent keys per laptop.
Jwt__SigningKey=replace-with-shared-development-signing-key
IdentityProtection__ActiveEncryptionVersion=neon-dev-v1
IdentityProtection__ActiveHmacVersion=neon-dev-v1
IdentityProtection__EncryptionKeys__neon-dev-v1=replace-with-shared-base64-32-byte-encryption-key
IdentityProtection__HmacKeys__neon-dev-v1=replace-with-separate-shared-base64-32-byte-hmac-key
ObjectStorage__Endpoint=localhost:9000
ObjectStorage__Bucket=bhome-private
ObjectStorage__UseSsl=false
ObjectStorage__AccessKey=replace-with-bucket-scoped-access-key
ObjectStorage__SecretKey=replace-with-bucket-scoped-secret-key
