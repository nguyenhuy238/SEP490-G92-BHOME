          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "https://localhost:7240/api/v1/auth/login",
        "description": "Điền email và mật khẩu test thật vào Body. Gửi request, copy accessToken từ response. expiresAt phải khoảng 30 phút sau thời điểm cấp. Nguồn: PostgresAuthenticationTests.LoginVerifiesStoredPasswordAndRolesThenAuthenticatesSession.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner.dev@example.invalid\",\n  \"password\": \"DIEN_MAT_KHAU_TEST_CUA_BAN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
