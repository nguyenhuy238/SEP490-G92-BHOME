          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const refreshToken = pm.environment.get(\u0027refreshToken\u0027);",
                  "if (!refreshToken) throw new Error(\u0027Hãy login/refresh theo thứ tự trước.\u0027);",
                  "pm.environment.set(\u0027retiredRefreshToken\u0027, refreshToken);",
                  "pm.variables.set(\u0027requestBody\u0027, JSON.stringify({refreshToken}));"
                ]
