// BHOME compact target: exactly 24 tables. SQL is authoritative for triggers and partial indexes.
// JSON companion: BHOME_Database_Design.json, synchronized to the same 386 columns and 83 FK relations.
// Native Compact24 runtime adapters implemented; schema version compact24-2026-11-04.
// Initialize an empty target offline; use the separate tool for 70-to-24 data conversion.
Project BHOME_24 {
  database_type: 'PostgreSQL'
}

Table assets {
  id "uuid" [pk, not null]
  location_id "uuid" [not null]
  room_id "uuid"
  common_area "character varying(200)"
  asset_code "character varying(80)"
  name "character varying(150)" [not null]
  category "character varying(80)" [not null]
  condition "text" [not null]
  status "smallint" [not null]
  purchase_info "jsonb" [not null]
  version "integer" [not null]
  history "jsonb" [not null]
  indexes {
    (id, location_id) [unique]
  }
}

Table billing_policies {
  id "uuid" [pk, not null]
  location_id "uuid" [not null]
  room_id "uuid"
  room_type_id "uuid"
  charge_code "character varying(80)" [not null]
  category "smallint" [not null]
  calculation_method "character varying(30)" [not null]
  rate "numeric(18,4)" [not null]
  parameters "jsonb" [not null]
  effective_from "date" [not null]
  effective_to "date"
  first_used_at "timestamp with time zone"
  version "integer" [not null]
  history "jsonb" [not null]
}

Table contract_residents {
  contract_id "uuid" [not null]
  resident_id "uuid" [not null]
  resident_role "smallint" [not null]
  residence_from "date" [not null]
  residence_to "date"
  actual_residence_from "date"
  actual_move_out_date "date"
  registration_status "character varying(25)"
  registration_evidence_key "character varying(250)"
  registration_result_at "timestamp with time zone"
  owner_confirmed_by_user_id "uuid"
  owner_confirmed_at "timestamp with time zone"
  history "jsonb" [not null]
  indexes {
    (contract_id, resident_id) [pk]
  }
}

Table contract_signings {
  id "uuid" [pk, not null]
  contract_id "uuid" [not null]
  signer_user_id "uuid" [not null]
  certificate_id "uuid" [not null]
  certificate_snapshot "jsonb" [not null]
  provider_code "character varying(50)" [not null]
  provider_reference "character varying(200)"
  signing_status "smallint" [not null]
  snapshot_hash "character varying(64)" [not null]
  source_hash "character varying(64)"
  prepared_hash "character varying(64)"
  prepared_object_key "character varying(250)"
  signed_object_key "character varying(250)"
  signed_hash "character varying(64)"
  signing_data "jsonb" [not null]
  requested_at "timestamp with time zone" [not null]
  expires_at "timestamp with time zone" [not null]
  signed_at "timestamp with time zone"
  history "jsonb" [not null]
}

Table contracts {
  id "uuid" [pk, not null]
