  monthly_rent "numeric(18,0)"
  deposit_required "numeric(18,0)" [not null]
  applied_holding_deposit "numeric(18,0)" [not null]
  reserved_capacity "smallint"
  terms "text" [not null]
  snapshot_hash "character varying(64)"
  draft_metadata "jsonb" [not null]
  documents "jsonb" [not null]
  handover "jsonb" [not null]
  move_out "jsonb" [not null]
  settlement "jsonb" [not null]
  status "smallint" [not null]
  activated_at "timestamp with time zone"
  activated_by_user_id "uuid"
  actual_end_date "date"
  version "integer" [not null]
  history "jsonb" [not null]
}

Table expenses {
  id "uuid" [pk, not null]
