# Copy to .env; replace every replace-with-* placeholder. Never commit .env.
# Compose data services (local only). Bindings are loopback-only.
POSTGRES_DB=bhome
POSTGRES_USER=bhome_local
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Development API reads local .env as a fallback; secrets/env/CLI have higher priority.
# Production never reads this file; see docs/development/LOCAL_DEVELOPMENT.md.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=bhome;Username=bhome_local;Password=replace-with-local-postgres-password
# Development startup creates Compact24 only when missing/empty; never resets existing data.
DevelopmentDatabase__InitializeOnStartup=true
Jwt__SigningKey=replace-with-random-key-at-least-32-bytes
Jwt__LifetimeMinutes=30
# Approved policy: 1-7 days, default 7; refresh never extends the original session deadline.
Sessions__RefreshTokenDays=7
Sessions__AbsoluteLifetimeDays=7
Sessions__PasswordResetMinutes=15
AuthRateLimit__PermitLimit=30
AuthRateLimit__WindowSeconds=60
# Only the trusted Owner Web origin may use the refresh cookie; not the Public Website.
AuthWeb__AllowedOrigins__0=http://localhost:5173
ObjectStorage__Endpoint=localhost:9000
ObjectStorage__AccessKey=replace-with-scoped-storage-access-key
ObjectStorage__SecretKey=replace-with-scoped-storage-secret-key
ObjectStorage__Bucket=bhome-private
ObjectStorage__UseSsl=false
Jobs__Enabled=false
# Notification MVP: Sandbox is accepted only in Development/Testing; production Email uses Smtp.
NotificationChannels__Enabled=false
NotificationChannels__AutomationEnabled=false
NotificationChannels__Mode=Unconfigured
NotificationChannels__MaxAttempts=4
NotificationChannels__RetrySeconds=30
NotificationChannels__TimeoutSeconds=15
NotificationChannels__SmtpHost=
NotificationChannels__SmtpPort=587
NotificationChannels__SmtpUseTls=true
NotificationChannels__SmtpUser=
NotificationChannels__SmtpPassword=
NotificationChannels__FromAddress=
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175

# Reserved categories; unconfigured adapters remain unavailable until real providers are selected.
BankIntegration__BaseUrl=https://replace-with-bank-provider.example
BankIntegration__ApiKey=replace-with-provider-secret
NotificationIntegration__BaseUrl=https://replace-with-notification-provider.example
NotificationIntegration__ApiKey=replace-with-provider-secret
ElectronicContractIntegration__BaseUrl=https://replace-with-contract-provider.example
ElectronicContractIntegration__ApiKey=replace-with-provider-secret

# Digital signing (Viettel MySign remote signing). SecretKey encrypts the client secret the Owner saves on screen.
DigitalSigning__SecretKey=replace-with-random-key-at-least-32-characters
# Optional: the account can be entered on the Owner portal instead (Hop dong > Chu ky va tai lieu > Anh chu ky va tai khoan Viettel MySign).
DigitalSigning__Viettel__BaseUrl=https://remotesigning.viettel.vn
DigitalSigning__Viettel__ClientId=
DigitalSigning__Viettel__ClientSecret=
DigitalSigning__Viettel__ProfileId=
# Desired-inventory synchronization only; does not enable financial jobs.
OwnerSetup__AssetSyncEnabled=false
# Internal acceptance uses its own random Base64 key (at least 32 bytes); no default or JWT-key reuse.
AnonymousSigning__OtpHmacKey=
# Optional approved HTTPS page, without query or fragment. Otherwise invite email provides a Mobile paste code.
AnonymousSigning__PublicSigningUrl=
