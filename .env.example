# Copy to .env; replace every replace-with-* placeholder. Never commit .env.
# Compose data services (local only). Bindings are loopback-only.
POSTGRES_DB=bhome
POSTGRES_USER=bhome_local
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# These examples are NOT loaded by dotnet run automatically.
# Use user-secrets or export environment variables; see docs/development/LOCAL_DEVELOPMENT.md.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=bhome;Username=bhome_local;Password=replace-with-local-postgres-password
Jwt__SigningKey=replace-with-random-key-at-least-32-bytes
ObjectStorage__Endpoint=localhost:9000
ObjectStorage__AccessKey=replace-with-scoped-storage-access-key
ObjectStorage__SecretKey=replace-with-scoped-storage-secret-key
ObjectStorage__Bucket=bhome-private
ObjectStorage__UseSsl=false
Jobs__Enabled=false
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175

# Reserved categories; unconfigured adapters remain unavailable until real providers are selected.
BankIntegration__BaseUrl=https://replace-with-bank-provider.example
BankIntegration__ApiKey=replace-with-provider-secret
NotificationIntegration__BaseUrl=https://replace-with-notification-provider.example
NotificationIntegration__ApiKey=replace-with-provider-secret
ElectronicContractIntegration__BaseUrl=https://replace-with-contract-provider.example
ElectronicContractIntegration__ApiKey=replace-with-provider-secret
