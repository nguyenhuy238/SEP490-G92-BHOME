# Copy to .env; replace every replace-with-* placeholder. Never commit .env.
ASPNETCORE_ENVIRONMENT=Development
# Compose data services (local only). Bindings are loopback-only.
POSTGRES_DB=bhome
POSTGRES_USER=bhome_local
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Development API reads local .env as a fallback; secrets/env/CLI have higher priority.
# Production never reads this file; see docs/development/LOCAL_DEVELOPMENT.md.
# Hostnames only, separated by semicolons (no scheme, path or port).
# Local development needs no public tunnel. Add an explicit LAN hostname only when required.
# Restart Start-Api.ps1 after changing this value. Never use * for a public tunnel.
AllowedHosts=localhost;127.0.0.1
ConnectionStrings__Database=Host=localhost;Port=5432;Database=bhome;Username=bhome_local;Password=replace-with-local-postgres-password
# Development startup creates Compact24 only when missing/empty; never resets existing data.
DevelopmentDatabase__InitializeOnStartup=true
Jwt__SigningKey=replace-with-random-key-at-least-32-bytes
Jwt__LifetimeMinutes=30
# Approved policy: 1-7 days, default 7; refresh never extends the original session deadline.
Sessions__RefreshTokenDays=7
Sessions__AbsoluteLifetimeDays=7
Sessions__PasswordResetMinutes=15
AuthRateLimit__PermitLimit=30
AuthRateLimit__WindowSeconds=60
# Only the trusted Owner Web origin may use the refresh cookie; not the Public Website.
AuthWeb__AllowedOrigins__0=http://localhost:5173
AuthWeb__AllowedOrigins__1=https://localhost:5176
ObjectStorage__Endpoint=localhost:9000
ObjectStorage__AccessKey=replace-with-scoped-storage-access-key
ObjectStorage__SecretKey=replace-with-scoped-storage-secret-key
ObjectStorage__Bucket=bhome-private
ObjectStorage__UseSsl=false
Jobs__Enabled=false
# Staff handoffs remain date-aware when general background jobs are disabled.
# Reconciles Location responsibility only (no contract expiry, invoices, or meter issuance).
# Development enables this by default. Explicitly configure it in other environments when Jobs are disabled.
StaffAssignments__AutoReconcileEnabled=true
StaffAssignments__PollSeconds=60
# Notification channels: Sandbox is accepted only in Development/Testing.
NotificationChannels__Enabled=true
NotificationChannels__AutomationEnabled=true
NotificationChannels__Mode=Unconfigured
NotificationChannels__MaxAttempts=4
NotificationChannels__RetrySeconds=60
NotificationChannels__TimeoutSeconds=15
NotificationChannels__SmtpHost=
NotificationChannels__SmtpPort=587
NotificationChannels__SmtpUseTls=true
NotificationChannels__SmtpUser=
NotificationChannels__SmtpPassword=
NotificationChannels__FromAddress=
# Local Mailpit capture, never forwards messages to real mailboxes.
# Real SMTP uses DeliveryMode=Smtp, mandatory STARTTLS, and AllowedRecipients outside Production.
Email__Enabled=true
Email__DeliveryMode=Capture
Email__Host=localhost
Email__Port=1025
Email__Username=
Email__FromEmail=bhome@example.invalid
Email__FromName=BHOME
Email__UseStartTls=true
Email__TimeoutSeconds=30
Email__TestEnabled=false
Email__TestRecipient=
# Email__AppPassword is intentionally omitted. Never commit a real value.
# Authentication callbacks: set trusted URLs for the deployed clients; do not use localhost in Production.
AuthenticationEmail__WebResetUrl=http://localhost:5173/reset-password
AuthenticationEmail__WebInvitationUrl=http://localhost:5173/accept-invitation
AuthenticationEmail__MobileResetUrl=bhome://reset-password
AuthenticationEmail__MobileInvitationUrl=bhome://accept-invitation
AuthenticationEmail__WebVerificationUrl=http://localhost:5173/confirm-email
AuthenticationEmail__MobileVerificationUrl=bhome://confirm-email
AuthenticationEmail__TrustedOrigins__0=http://localhost:5173
AuthenticationEmail__TrustedOrigins__1=bhome://reset-password
AuthenticationEmail__TrustedOrigins__2=bhome://accept-invitation
AuthenticationEmail__TrustedOrigins__3=bhome://confirm-email
AuthenticationEmail__ResendCooldownSeconds=60
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175
# Match appsettings.Development.json indices; configuration arrays merge by index.
Cors__AllowedOrigins__3=http://localhost:8081
Cors__AllowedOrigins__4=http://127.0.0.1:8081
Cors__AllowedOrigins__5=http://localhost
Cors__AllowedOrigins__6=capacitor://localhost
Cors__AllowedOrigins__7=https://localhost:5176
# Append custom/tunnel origins at index 8 or later; do not overwrite Mobile Web above.

# Reserved categories; unconfigured adapters remain unavailable until real providers are selected.
BankIntegration__BaseUrl=https://replace-with-bank-provider.example
BankIntegration__ApiKey=replace-with-provider-secret
# SePay is opt-in. Configure a separate secret and token in an ignored environment file.
SePay__Enabled=false
SePay__Mode=Test
SePay__ApiBaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__ApiToken=
SePay__WebhookSecret=replace-with-random-secret-at-least-32-characters
SePay__WebhookPath=/api/v1/integrations/sepay/webhook
SePay__PaymentCodePrefix=BH
SePay__RequestTimeoutSeconds=15
SePay__SignatureToleranceSeconds=300
SePay__PollIntervalSeconds=60
# Replace this empty GUID with the receiving Location before enabling SePay.
SePay__ReceivingAccounts__0__LocationId=00000000-0000-0000-0000-000000000000
SePay__ReceivingAccounts__0__BankIdentifier=replace-with-bank-bin
SePay__ReceivingAccounts__0__Gateway=replace-with-sepay-gateway-name
SePay__ReceivingAccounts__0__AccountNumber=replace-with-test-account-number
NotificationIntegration__BaseUrl=https://replace-with-notification-provider.example
NotificationIntegration__ApiKey=replace-with-provider-secret
ElectronicContractIntegration__BaseUrl=https://replace-with-contract-provider.example
ElectronicContractIntegration__ApiKey=replace-with-provider-secret

# Digital signing (Viettel MySign remote signing). SecretKey encrypts the client secret the Owner saves on screen.
DigitalSigning__SecretKey=replace-with-random-key-at-least-32-characters
# Optional: the account can be entered on the Owner portal instead (Hop dong > Chu ky va tai lieu > Anh chu ky va tai khoan Viettel MySign).
DigitalSigning__Viettel__BaseUrl=https://remotesigning.viettel.vn
DigitalSigning__Viettel__ClientId=
DigitalSigning__Viettel__ClientSecret=
DigitalSigning__Viettel__ProfileId=
# Desired-inventory synchronization only; does not enable financial jobs.
OwnerSetup__AssetSyncEnabled=false
# Internal acceptance uses its own random Base64 key (at least 32 bytes); no default or JWT-key reuse.
AnonymousSigning__OtpHmacKey=
# Optional approved HTTPS page, without query or fragment. Otherwise invite email provides a Mobile paste code.
AnonymousSigning__PublicSigningUrl=https://localhost:5176/contract-signing
# "Bạn có hợp đồng cần ký" email button: opens the app on the contract's signing page (sign-in first when needed).
# App link base, "?contractId=<id>" is appended. Expo Go during development: exp://<LAN IP>:8081/--/sign-contract
ContractSigning__InvitationLink__MobileAppUrl=bhome://sign-contract
# Optional http(s) URL of GET /open/sign-contract on this API as the phone reaches it (Gmail drops app-scheme links).
# Example: https://<LAN IP>:7240/open/sign-contract. Empty: the email links to MobileAppUrl directly.
ContractSigning__InvitationLink__PublicOpenUrl=https://localhost:7240/open/sign-contract
# SMS defaults: disabled. Put real keys in environment or .NET User Secrets only.
Sms__Enabled=false
Sms__Mode=Mock
Sms__Provider=Esms
Sms__ProductionEnabled=false
Sms__ApiKey=
Sms__SecretKey=
Sms__Brandname=
# Use indexed entries for template allowlists.
# Enable SMS-01 after provider approval when setting up real password-recovery OTP.
# Sms__EnabledTemplates__0=SMS-01
# Sms__ApprovedTemplates__0=SMS-01
Sms__TimeoutSeconds=10
Sms__DemoIsolated=false
Sms__CallbackUrl=
Sms__LiveTestEnabled=false
SmsRecovery__Enabled=false
# Base64 encoding of at least 32 random bytes, supplied only through secrets.
SmsRecovery__HashKey=
SmsRecovery__OtpMinutes=5
SmsRecovery__MaxAttempts=5
SmsRecovery__ResendCooldownSeconds=60
SmsRecovery__AuthorizationMinutes=5
SmsRecovery__MaxAccountRequests=5
SmsRecovery__MaxPhoneRequests=5
SmsRecovery__MaxIpRequests=20
