# REFERENCE ONLY. Copy into reviewed infrastructure, never install by this file alone.
# Requires BHOME_OWNER_DOMAIN, BHOME_ACME_EMAIL, BHOME_API_UPSTREAM and
# BHOME_OWNER_UPSTREAM environment variables.
# DNS, TLS, proxy trust, backups and secrets must be independently verified.
# The browser connects to one HTTPS origin for both Owner Web and the API;
# the API and Owner Web containers themselves only listen on a private network.
# Existing staging names bhome-sepay-stage-api/bhome-sepay-stage-owner are not
# connected by this example. An operator must check Docker networks/aliases
# and merge with the existing Caddy config; DO NOT replace live ingress.
# In Production the API's separate public host remains a separate deployment
# concern; this example only illustrates an Owner-host, same-origin proxy.
{
    email {$BHOME_ACME_EMAIL}
}

{$BHOME_OWNER_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }

    # Keep internal health endpoints outside the public routing surface.
    @privateHealth path /health /health/*
    respond @privateHealth 404

    # No strip_prefix: ASP.NET controllers expect their full /api/v1/... paths.
    # The email's /open/sign-contract link is also an API endpoint.
    @backend path /api/* /open/sign-contract
    handle @backend {
        reverse_proxy {$BHOME_API_UPSTREAM}
    }

    handle {
        reverse_proxy {$BHOME_OWNER_UPSTREAM}
    }
}
