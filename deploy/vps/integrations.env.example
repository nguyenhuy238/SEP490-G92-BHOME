# SMTP account shared by the BHome deployment
BHOME_EMAIL_USERNAME=bhome.notification@gmail.com

# Set a real Google App Password only in VPS stack.env
BHOME_EMAIL_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Generate a 32-byte random key and Base64-encode it
# Keep the deployed key stable across container restarts
BHOME_ANON_HMAC_BASE64=REPLACE_WITH_BASE64_KEY

# OWNER_HOST and API_HOST are defined
# in the existing VPS stack.env
