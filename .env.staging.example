# Dedicated VPS Staging API env_file. Copy only to a NEW private file outside Git.
# Preserve existing /opt/bhome-config secrets and database; do not overwrite them.
ASPNETCORE_ENVIRONMENT=Staging
Deployment__Environment=Staging
Deployment__OwnerOrigin=https://api-sepay-test.103.146.23.157.sslip.io
Deployment__ApiOrigin=https://api-sepay-test.103.146.23.157.sslip.io
AllowedHosts=api-sepay-test.103.146.23.157.sslip.io
# Caddy serves the Staging Owner build at / on this host; /api/* and /open/* go to Staging API.
# Missing legacy callback/CORS/trusted-origin keys are derived from Deployment origins.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=bhome_sepay_stage;Username=bhome_stage;Password=replace-with-separate-staging-password
Jwt__SigningKey=replace-with-separate-staging-key-at-least-32-bytes
ObjectStorage__Endpoint=stage-minio:9000
ObjectStorage__AccessKey=replace-with-staging-storage-user
ObjectStorage__SecretKey=replace-with-staging-storage-secret
ObjectStorage__Bucket=bhome-staging-private
ObjectStorage__UseSsl=false
AnonymousSigning__OtpHmacKey=replace-with-stable-staging-base64-key
DigitalSigning__SecretKey=replace-with-stable-staging-key
ContractSigning__InvitationLink__MobileAppUrl=bhome://sign-contract
ContractSigning__Otp__DevelopmentLogCode=false
DevelopmentDatabase__InitializeOnStartup=false
Api__UseHttpsRedirection=false
Email__Enabled=true
Email__DeliveryMode=Smtp
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=replace-with-staging-sender@example.invalid
Email__FromEmail=replace-with-staging-sender@example.invalid
Email__AppPassword=replace-with-separate-staging-app-password
Email__UseStartTls=true
NotificationChannels__Enabled=true
NotificationChannels__AutomationEnabled=true
NotificationChannels__Mode=Unconfigured
Jobs__Enabled=false
# Opt in to Owner manual billing demo actions on Staging only; does not enable workers.
# VPS value belongs in private compose.staging-runtime.yml, not the image release overlay.
BillingAutomation__ManualActionsEnabled=false
BillingAutomation__AutomaticJobsEnabled=true
SePay__Enabled=true
SePay__Mode=Test
SePay__ApiBaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__ApiToken=replace-with-existing-staging-api-token
SePay__WebhookSecret=replace-with-existing-staging-hmac-secret
SePay__WebhookPath=/api/v1/integrations/sepay/webhook
SePay__ReceivingAccounts__0__LocationId=00000000-0000-0000-0000-000000000000
SePay__ReceivingAccounts__0__BankIdentifier=replace-with-existing-staging-bank-bin
SePay__ReceivingAccounts__0__Gateway=replace-with-existing-staging-gateway
SePay__ReceivingAccounts__0__AccountNumber=replace-with-existing-staging-account
# Fixed webhook: https://api-sepay-test.103.146.23.157.sslip.io/api/v1/integrations/sepay/webhook

# Academic deployment: Demo Clock available, real calendar by default.
# Optional UUID restricts date changes to a single Owner. Blank allows authenticated Owners.
# Set Enabled=false to remove the capability.
DemoClock__Enabled=true
DemoClock__OwnerUserId=
