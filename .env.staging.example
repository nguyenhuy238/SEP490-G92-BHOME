# REFERENCE ONLY. This file is not loaded automatically in Staging.
# Replace every *.example.invalid placeholder host and supply secrets through a protected
# runtime env file / secret manager. Do not deploy with this file as-is.
# ASP.NET Core reads env vars named Section__Property. There is no Deployment__
# options binding in the current API, so no Deployment__ keys are defined here.
# Existing project bhome-sepay-stage: staging API is
# https://api-sepay-test.103.146.23.157.sslip.io ; Owner Web is planned on
# the same host but NOT deployed yet. This file changes neither service.
ASPNETCORE_ENVIRONMENT=Staging
AllowedHosts=api-sepay-test.103.146.23.157.sslip.io
# Preserve the API's default HTTPS redirection for existing ingress. The
# standalone Compose reference overrides it only within a private Caddy setup.
DevelopmentDatabase__InitializeOnStartup=false

# Required via secret manager (omitted intentionally):
# ConnectionStrings__Database = scoped PostgreSQL connection string
# Jwt__SigningKey = distinct strong random secret (>= 32 bytes)
# IdentityProtection__* = approved encryption/HMAC key versions and keys
# ObjectStorage__AccessKey / ObjectStorage__SecretKey = scoped private bucket credentials
# DigitalSigning__SecretKey, AnonymousSigning__OtpHmacKey when those flows are approved
# Email__AppPassword and Email__Username when outbound SMTP is enabled
Jwt__Issuer=BHome
Jwt__Audience=BHome.Clients
Jwt__LifetimeMinutes=30
Sessions__RefreshTokenDays=7
Sessions__AbsoluteLifetimeDays=7
Sessions__PasswordResetMinutes=15
AuthRateLimit__PermitLimit=30
AuthRateLimit__WindowSeconds=60
AuthWeb__AllowedOrigins__0=https://api-sepay-test.103.146.23.157.sslip.io
Cors__AllowedOrigins__0=https://api-sepay-test.103.146.23.157.sslip.io

ObjectStorage__Endpoint=storage.staging.example.invalid:9000
ObjectStorage__Bucket=bhome-private-staging
ObjectStorage__UseSsl=true

# Keep automatic billing and external signing disabled until separately reviewed.
Jobs__Enabled=false
BillingAutomation__AutomaticJobsEnabled=false
# Team guide keeps this existing staging project on the SePay sandbox. The
# current SePayOptions.Valid allows Mode=Test in Staging but not Production.
# Enabled requires real secured WebhookSecret and ReceivingAccounts values.
SePay__Enabled=true
SePay__Mode=Test
SePay__ApiBaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__WebhookPath=/api/v1/integrations/sepay/webhook
SePay__PaymentCodePrefix=BH
SePay__RequestTimeoutSeconds=15
SePay__SignatureToleranceSeconds=300
SePay__PollIntervalSeconds=60
# Existing webhook URL: DO NOT modify the registered provider callback here.
# https://api-sepay-test.103.146.23.157.sslip.io/api/v1/integrations/sepay/webhook
# Required secret/config injection: SePay__WebhookSecret (>=32 chars),
# SePay__ApiToken if used, SePay__ReceivingAccounts__0__* with actual assigned LocationId.
ContractWorkflow__SimulatedSigningEnabled=false
ContractSigning__Methods__Otp=false
ContractSigning__Methods__ViettelMySign=false
ContractSigning__Methods__UploadProof=false

# Staging email is off until the approved authenticated STARTTLS relay is configured.
# Capture/Mailpit is restricted by code to Development/Testing; the built-in
# Email__TestEnabled endpoint also only works in Development. A staging-specific
# outgoing-email recipient allowlist has NOT been implemented.
Email__DeliveryMode=Smtp
Email__Enabled=false
Email__TestEnabled=false
Email__Host=smtp.staging.example.invalid
Email__Port=587
Email__UseStartTls=true
Email__FromEmail=notifications@staging.example.invalid
Email__FromName=BHOME Staging
NotificationChannels__Enabled=false
NotificationChannels__AutomationEnabled=false
NotificationChannels__Mode=Unconfigured

AuthenticationEmail__WebResetUrl=https://api-sepay-test.103.146.23.157.sslip.io/reset-password
AuthenticationEmail__WebInvitationUrl=https://api-sepay-test.103.146.23.157.sslip.io/accept-invitation
AuthenticationEmail__WebVerificationUrl=https://api-sepay-test.103.146.23.157.sslip.io/confirm-email
AuthenticationEmail__MobileResetUrl=bhome://reset-password
AuthenticationEmail__MobileInvitationUrl=bhome://accept-invitation
AuthenticationEmail__MobileVerificationUrl=bhome://confirm-email
AuthenticationEmail__TrustedOrigins__0=https://api-sepay-test.103.146.23.157.sslip.io
AuthenticationEmail__TrustedOrigins__1=bhome://reset-password
AuthenticationEmail__TrustedOrigins__2=bhome://accept-invitation
AuthenticationEmail__TrustedOrigins__3=bhome://confirm-email
# Internal OTP acceptance requires separate approval and a secure OTP HMAC key.
AnonymousSigning__PublicSigningUrl=https://api-sepay-test.103.146.23.157.sslip.io/contract-signing
ContractSigning__InvitationLink__MobileAppUrl=bhome://sign-contract
ContractSigning__InvitationLink__PublicOpenUrl=https://api-sepay-test.103.146.23.157.sslip.io/open/sign-contract
