# Server only. Copy to a private root-owned file, chmod 600. Never include in a web/mobile bundle.
# Assign a different, permanent 4-character uppercase code to EVERY deployment sharing a bank account.
SePay__Enabled=true
SePay__Mode=Test
SePay__InstanceCode=STG1
SePay__Test__Enabled=true
SePay__Test__ApiBaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__Test__ApiToken=replace-with-test-token
SePay__Test__WebhookSecret=replace-with-independent-test-hmac-secret-at-least-32-characters
SePay__Test__WebhookPath=/api/v1/integrations/sepay/Test/webhook
SePay__Test__PollIntervalSeconds=60
SePay__Test__ReceivingAccounts__0__OwnerUserId=replace-with-owner-uuid
SePay__Test__ReceivingAccounts__0__BankIdentifier=replace-with-test-bank-bin
SePay__Test__ReceivingAccounts__0__Gateway=replace-with-test-bank-brand
SePay__Test__ReceivingAccounts__0__AccountNumber=replace-with-test-account-number
SePay__Live__Enabled=true
SePay__Live__ApiBaseUrl=https://userapi.sepay.vn/v2
SePay__Live__ApiToken=replace-with-live-token
SePay__Live__WebhookSecret=replace-with-independent-live-hmac-secret-at-least-32-characters
SePay__Live__WebhookPath=/api/v1/integrations/sepay/Live/webhook
SePay__Live__PollIntervalSeconds=60
SePay__Live__ReceivingAccounts__0__OwnerUserId=replace-with-owner-uuid
SePay__Live__ReceivingAccounts__0__BankIdentifier=replace-with-linked-bank-bin
SePay__Live__ReceivingAccounts__0__Gateway=replace-with-linked-bank-brand
SePay__Live__ReceivingAccounts__0__AccountNumber=replace-with-linked-bank-account-number
# Public callbacks: /api/v1/integrations/sepay/Test/webhook and /api/v1/integrations/sepay/Live/webhook
# Legacy /webhook retains SePay__Mode as its fixed server-side mode; Owner switching never changes this route.
# Legacy BH + 8-digit codes need explicit ownership after reviewing ALL shared-bank deployments.
# Assign each existing code to exactly one deployment in its original mode. Never copy these lists.
# SePay__Test__LegacyPaymentCodes__0=BH12345678
# SePay__Live__LegacyPaymentCodes__0=BH87654321
