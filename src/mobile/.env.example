# Local development: leave empty; npm run mobile selects this workstation automatically.
# For a shared deployed backend, set its HTTPS origin, then fully reload the app.
EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid
# Never copy another workstation's .env.local, .tools, CA private key or dev server ID.
# Requires __DEV__ and an isolated Mock backend; never exposes production OTPs.
EXPO_PUBLIC_SMS_DEMO_ENABLED=false
