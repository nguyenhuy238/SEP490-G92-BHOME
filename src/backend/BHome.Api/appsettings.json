{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Jwt": { "Issuer": "BHome", "Audience": "BHome.Clients", "LifetimeMinutes": 30 },
  "Sessions": { "RefreshTokenDays": 7, "AbsoluteLifetimeDays": 7, "PasswordResetMinutes": 15 },
  "AuthRateLimit": { "PermitLimit": 30, "WindowSeconds": 60 },
  "AuthWeb": { "AllowedOrigins": [] },
  "ObjectStorage": { "Endpoint": "localhost:9000", "Bucket": "bhome-private", "UseSsl": true },
  "Jobs": { "Enabled": false, "PollSeconds": 5 },
  "BillingAutomation": { "AutomaticJobsEnabled": false },
  "NotificationChannels": {
    "Enabled": false,
    "AutomationEnabled": true,
    "Mode": "Unconfigured",
    "MaxAttempts": 4,
    "RetrySeconds": 60,
    "TimeoutSeconds": 15
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "bhome.notification@gmail.com",
    "FromEmail": "bhome.notification@gmail.com",
    "FromName": "BHOME",
    "UseStartTls": true,
    "TimeoutSeconds": 30
  },
  "ExpoPush": {
    "Enabled": false,
    "TimeoutSeconds": 15
  },
  "IdentityRetention": {
    "ApprovedDecisionReference": null,
    "RetentionDays": null,
    "StartBasis": null
  },
  "Ocr": {
    "Enabled": false,
    "MeterRecognitionEnabled": false,
    "ModelDirectory": "/models",
    "MaxImageBytes": 5242880,
    "MaxPixels": 12000000,
    "MaxDimension": 1600,
    "TimeoutMilliseconds": 9000,
    "MaxConcurrency": 1,
    "InferenceThreads": 2,
    "MaxTextRegions": 48
  },
  "Api": { "UseHttpsRedirection": true },
  "Cors": { "AllowedOrigins": [] }
}
