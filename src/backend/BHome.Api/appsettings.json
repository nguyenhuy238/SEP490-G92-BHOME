{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Jwt": { "Issuer": "BHome", "Audience": "BHome.Clients", "LifetimeMinutes": 15 },
  "Sessions": { "RefreshTokenDays": 7, "AbsoluteLifetimeDays": 7, "PasswordResetMinutes": 15 },
  "AuthRateLimit": { "PermitLimit": 30, "WindowSeconds": 60 },
  "AuthWeb": { "AllowedOrigins": [] },
  "ObjectStorage": { "Endpoint": "localhost:9000", "Bucket": "bhome-private", "UseSsl": true },
  "Jobs": { "Enabled": false, "PollSeconds": 5 },
  "Ocr": {
    "Enabled": false,
    "ModelDirectory": "/models",
    "MaxImageBytes": 5242880,
    "MaxPixels": 12000000,
    "MaxDimension": 1600,
    "TimeoutMilliseconds": 8000,
    "MaxConcurrency": 1,
    "InferenceThreads": 2,
    "MaxTextRegions": 48
  },
  "Api": { "UseHttpsRedirection": true },
  "Cors": { "AllowedOrigins": [] }
}
