{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Jwt": { "Issuer": "BHome", "Audience": "BHome.Clients", "LifetimeMinutes": 15 },
  "ObjectStorage": { "Endpoint": "localhost:9000", "Bucket": "bhome-private", "UseSsl": true },
  "Jobs": { "Enabled": false, "PollSeconds": 5 },
  "Api": { "UseHttpsRedirection": true },
  "Cors": { "AllowedOrigins": [] }
}
