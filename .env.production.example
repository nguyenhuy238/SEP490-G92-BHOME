# REFERENCE ONLY. This file is not read automatically by the production API.
# Hostnames ending in example.invalid are placeholders and must be replaced.
# Supply credentials/keys via an external secret manager or protected runtime env.
# There is currently NO bound Deployment__ configuration section.
# Guide: Owner https://owner.103.146.23.157.sslip.io and
# API https://api.103.146.23.157.sslip.io. Do not change existing VPS endpoints.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=api.103.146.23.157.sslip.io;owner.103.146.23.157.sslip.io
# Retain API default HTTPS redirection in the existing VPS configuration.
# The separate Compose reference illustrates an edge-TLS-only override.
DevelopmentDatabase__InitializeOnStartup=false

# Mandatory protected runtime values (not included in this example):
# ConnectionStrings__Database, Jwt__SigningKey, IdentityProtection__* versions/keys
# ObjectStorage__AccessKey, ObjectStorage__SecretKey, DigitalSigning__SecretKey
# Provider credentials as approved; no developer/local secret reuse.
Jwt__Issuer=BHome
Jwt__Audience=BHome.Clients
Jwt__LifetimeMinutes=30
Sessions__RefreshTokenDays=7
Sessions__AbsoluteLifetimeDays=7
Sessions__PasswordResetMinutes=15
AuthRateLimit__PermitLimit=30
AuthRateLimit__WindowSeconds=60
AuthWeb__AllowedOrigins__0=https://owner.103.146.23.157.sslip.io
Cors__AllowedOrigins__0=https://owner.103.146.23.157.sslip.io

ObjectStorage__Endpoint=storage.example.invalid:9000
ObjectStorage__Bucket=bhome-private-production
ObjectStorage__UseSsl=true

Jobs__Enabled=false
BillingAutomation__AutomaticJobsEnabled=false
SePay__Enabled=false
SePay__Mode=Live
SePay__ApiBaseUrl=https://userapi.sepay.vn/v2
SePay__WebhookPath=/api/v1/integrations/sepay/webhook
ContractWorkflow__SimulatedSigningEnabled=false
ContractSigning__Methods__Otp=false
ContractSigning__Methods__ViettelMySign=false
ContractSigning__Methods__UploadProof=false

# Enable SMTP only with approved credentials and a real, trusted relay.
Email__DeliveryMode=Smtp
Email__Enabled=false
Email__Host=smtp.example.invalid
Email__Port=587
Email__UseStartTls=true
Email__FromEmail=notifications@example.invalid
Email__FromName=BHOME
NotificationChannels__Enabled=false
NotificationChannels__AutomationEnabled=false
NotificationChannels__Mode=Unconfigured

AuthenticationEmail__WebResetUrl=https://owner.103.146.23.157.sslip.io/reset-password
AuthenticationEmail__WebInvitationUrl=https://owner.103.146.23.157.sslip.io/accept-invitation
AuthenticationEmail__WebVerificationUrl=https://owner.103.146.23.157.sslip.io/confirm-email
AuthenticationEmail__MobileResetUrl=bhome://reset-password
AuthenticationEmail__MobileInvitationUrl=bhome://accept-invitation
AuthenticationEmail__MobileVerificationUrl=bhome://confirm-email
AuthenticationEmail__TrustedOrigins__0=https://owner.103.146.23.157.sslip.io
AuthenticationEmail__TrustedOrigins__1=bhome://reset-password
AuthenticationEmail__TrustedOrigins__2=bhome://accept-invitation
AuthenticationEmail__TrustedOrigins__3=bhome://confirm-email
# Link configuration alone does not enable internal OTP signing in Production.
AnonymousSigning__PublicSigningUrl=https://owner.103.146.23.157.sslip.io/contract-signing
ContractSigning__InvitationLink__MobileAppUrl=bhome://sign-contract
ContractSigning__InvitationLink__PublicOpenUrl=https://api.103.146.23.157.sslip.io/open/sign-contract
