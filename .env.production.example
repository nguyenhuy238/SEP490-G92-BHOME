# Published API env_file; existing VPS project bhome-vps. Never overwrite live secrets.
ASPNETCORE_ENVIRONMENT=Production
Deployment__Environment=Production
Deployment__OwnerOrigin=https://owner.103.146.23.157.sslip.io
Deployment__ApiOrigin=https://api.103.146.23.157.sslip.io
Deployment__PublicOrigin=https://www.103.146.23.157.sslip.io
AllowedHosts=owner.103.146.23.157.sslip.io;api.103.146.23.157.sslip.io
# Existing explicit callback keys remain supported, but must agree with these origins.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=bhome;Username=bhome_app;Password=replace-with-existing-production-password
Jwt__SigningKey=replace-with-existing-production-key-at-least-32-bytes
ObjectStorage__Endpoint=minio:9000
ObjectStorage__AccessKey=replace-with-existing-production-storage-user
ObjectStorage__SecretKey=replace-with-existing-production-storage-secret
ObjectStorage__Bucket=bhome-private
ObjectStorage__UseSsl=false
AnonymousSigning__OtpHmacKey=replace-with-existing-production-base64-key
DigitalSigning__SecretKey=replace-with-existing-production-key
ContractSigning__InvitationLink__MobileAppUrl=bhome://sign-contract
ContractSigning__Otp__DevelopmentLogCode=false
DevelopmentDatabase__InitializeOnStartup=false
Api__UseHttpsRedirection=false
Email__Enabled=true
Email__DeliveryMode=Smtp
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=replace-with-production-sender@example.invalid
Email__FromEmail=replace-with-production-sender@example.invalid
Email__AppPassword=replace-with-existing-production-app-password
Email__UseStartTls=true
NotificationChannels__Enabled=true
NotificationChannels__AutomationEnabled=true
NotificationChannels__Mode=Unconfigured
Jobs__Enabled=false
BillingAutomation__AutomaticJobsEnabled=true
# Live is NOT automatically enabled. Set credentials/accounts only after separate authorization.
SePay__Enabled=false
SePay__Mode=Live
SePay__ApiBaseUrl=https://userapi.sepay.vn/v2

# Academic Production portal supports Demo Clock while live banking is disabled.
# Real calendar by default. Optional Owner UUID restricts the global date control.
DemoClock__Enabled=true
DemoClock__OwnerUserId=
