<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Black-box integration tests written ONLY from the Integration Test plan
    (BHOME_Report-5.2_Integration_Test.xlsx, one folder per sheet). Routes/payloads that the plan does not
    state come from docs/api and the Postman collections. This project deliberately does NOT reference any
    BHome backend project: it calls a running API over HTTP and reads PostgreSQL only where the plan says so.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BHome.PlanIntegrationTests.Infrastructure" />
    <None Include="plan-tests.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
