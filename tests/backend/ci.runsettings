<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <!-- QA suites written from SRS v1.3 (Report 5.2 / bug hunt) record where the product still differs from the SRS.
         They are run on demand as QA evidence (dotnet test - -filter Suite=...), not as a merge gate. -->
    <TestCaseFilter>Suite!=Report-5.2-Authentication&amp;Suite!=QA-BugHunt&amp;Suite!=QA-SrsUnit</TestCaseFilter>
  </RunConfiguration>
  <xUnit>
    <MaxParallelThreads>2</MaxParallelThreads>
  </xUnit>
</RunSettings>
