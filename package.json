{
  "name": "bhome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/client-core",
    "src/owner-web",
    "src/mobile",
    "src/public-web"
  ],
  "scripts": {
    "mobile:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-OcrMobileApp.ps1",
    "mobile": "npm run start --workspace ./src/mobile --",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present -- --run",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9",
    "vitest": "^5.0.5",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1"
  }
}
