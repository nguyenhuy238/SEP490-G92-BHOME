# Template only. Initialize-SePaySandbox.ps1 generates private values; never share the resulting file.
BHOME_SEPAY_CONTAINER_NAME=replace-with-local-container-name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-postgres-password
POSTGRES_PORT=55432
BHOME_SEPAY_FIXTURE_PASSWORD=replace-with-random-fixture-password
ConnectionStrings__Database=Host=127.0.0.1;Port=55432;Database=bhome_compact24_dev_replace-with-database-id;Username=postgres;Password=replace-with-random-postgres-password
DevelopmentDatabase__InitializeOnStartup=true
Jwt__SigningKey=replace-with-random-jwt-key
Jwt__Issuer=BHome
Jwt__Audience=BHome.Clients
AllowedHosts=localhost;127.0.0.1
AuthWeb__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:8081
Jobs__Enabled=false
NotificationChannels__Enabled=false
NotificationChannels__AutomationEnabled=false
OwnerSetup__AssetSyncEnabled=false
Email__Enabled=false
SePay__Enabled=true
SePay__Mode=Test
SePay__ApiBaseUrl=https://userapi-sandbox.sepay.vn/v2
# Optional for webhook-only testing. Supply your own Test Mode token for polling.
SePay__ApiToken=
SePay__WebhookSecret=replace-with-random-webhook-secret
SePay__WebhookPath=/api/v1/integrations/sepay/webhook
SePay__PaymentCodePrefix=BH
SePay__PollIntervalSeconds=60
SePay__ReceivingAccounts__0__LocationId=replace-with-location-id
SePay__ReceivingAccounts__0__BankIdentifier=replace-with-sandbox-bank-bin
SePay__ReceivingAccounts__0__Gateway=replace-with-sandbox-gateway
SePay__ReceivingAccounts__0__AccountNumber=replace-with-sandbox-account
# Fixture-only input, not a frontend setting or new payment API field.
SePaySandbox__AccountHolder=replace-with-sandbox-account-holder
